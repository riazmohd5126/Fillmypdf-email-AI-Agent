# Anthropic API key (for later AI drafting stages)
ANTHROPIC_API_KEY=

# Postgres connection string (falls back to local SQLite if unset)
DATABASE_URL=

# "gmail" (design doc default) or "smtp" (e.g. testing from a Yahoo mailbox)
EMAIL_PROVIDER=gmail

# Gmail API OAuth (internal app authorized once as the outreach mailbox)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Generic SMTP, used when EMAIL_PROVIDER=smtp.
# Yahoo Mail: SMTP_HOST=smtp.mail.yahoo.com, SMTP_PORT=587, SMTP_USE_SSL=false
# (or SMTP_PORT=465, SMTP_USE_SSL=true). SMTP_PASSWORD must be a Yahoo
# app password (Yahoo Account Security > Generate app password), not your
# regular account password. Never commit real values here — this file is
# a template; put actual secrets only in your local untracked .env.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_SSL=false

SENDER_NAME=Riaz
SENDER_EMAIL=
PHYSICAL_ADDRESS=

# HMAC secret used to sign one-click unsubscribe tokens
UNSUBSCRIBE_SECRET=
UNSUBSCRIBE_BASE_URL=https://outreach.fillmypdf.com/u

DAILY_CAP=40
MIN_SEND_SPACING_SECONDS=180
MAX_SEND_SPACING_SECONDS=420
KILL_SWITCH=false
